# Copy to .env. NEVER commit actual credentials.
# DEMO_MODE=true disables authentication entirely. Use localhost ONLY.
DEMO_MODE=true
ADMIN_TOKEN=
DATABASE_URL=sqlite:///./resolveai.db
# Optional OpenAI-compatible endpoint; use a trusted HTTPS provider.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Phase 3: Google Gmail readonly OAuth credentials (use a dedicated support inbox)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=in:inbox newer_than:7d

# Share a Google Sheet with your service account email, then supply the local JSON path
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Orders!A:D

# Slack incoming webhook used ONLY for human escalations
SLACK_WEBHOOK_URL=
