# Copy to .env. Never commit credentials. Demo only for local development.
DEMO_MODE=true
ADMIN_TOKEN=
DATABASE_URL=sqlite:///./resolveai.db
ENABLE_API_DOCS=false

# Required for secure Docker / production-style deployment
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12

# Optional trusted OpenAI-compatible HTTPS endpoint
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Read-only Gmail access via OAuth (dedicated test inbox recommended)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_QUERY=in:inbox newer_than:7d

# Google Sheets read-only service account
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Orders!A:D

# Slack incoming webhook for human escalation only
SLACK_WEBHOOK_URL=
